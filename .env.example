# Optional cloud planner. Copy this file to .env; .env is excluded by .gitignore.
GEMINI_API_KEY=

# Planner models are discovered at runtime. Validated models are labeled Tested.

# Optional Groq cloud planner. The application default is openai/gpt-oss-120b.
GROQ_API_KEY=

# Optional OpenRouter Nemotron cloud/free planner.
OPENROUTER_API_KEY=
